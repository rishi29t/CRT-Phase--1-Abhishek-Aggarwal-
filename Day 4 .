// Problem 5 Holloow Square. 
Pattern :-
// * * * * *
// *       *
// *       *
// *       * 
// * * * * * 

int main(){
	int n;
	cout<<"enter rows :";// number of rows it will print .
	cin>>n;
	for(int i=1;i<=n;i++){
	    for(int j=1;j<=n;j++){
	        cout<<" ";
	        if(i==1 || i==n || j==1 || j==n){ // we using OR condition here. 
	        cout<<"*";
	        }else{
	            cout<<" ";
	        }
	    }
	    cout<<"\n";
	}
}

// Problem 6: 
// Inverted Right Angle Triangle 
//             *
//           * *    
//         * * *
//       * * * * 
//     * * * * *

int main(){
    int n;
    cout<<"enter rows :";// number of rows it will print .
    cin>>n;
    for(int i=1;i<=n;i++){          // outer loop 
        cout<<" ";
        for(int j=n-i;j>=1;j--){    // working loop for printing spaces 
        cout<<" ";
        }
            for(int k=1;k<=i;k++){
                cout<<"*";   
        }
    cout<<"\n";
    }
}

