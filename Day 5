Program 7
// function overloading
int add(int a,int b){
    return a + b ;
}
   
int add(int a,int b,int c){
    return a + b + c;    
    
}

float add(float a,float b,float c, float d){    // if we want to run float for 2 variable , we can't we need to change datatype to Double . 
    return a + b + c + d;
}

int main(){
    cout<< add(5,2) <<"\n";
    cout<< add(5,2,3)<<"\n";
    cout<< add(5.3,5.2,4.2,2.2);

}
