// Palindrome 
#include <iostream>
using namespace std;

bool isPalindrome(string str){
    int start=0;
    int end=str.size()-1;
    while(start < end){
        if(str[start] != str[end]){
            return false;
        }
        start++;
        end--;
    }
    return true;
}

int main()
{
    string str;
    
    cout<<"enter a string= ";
    cin >> str;
    
    if(isPalindrome(str)){
        cout<<"Your String is palindrome ..";
    }
    else{
        cout<<"It is not palindrom string..";
    }
    return 0;
}
#include <iostream>
using namespace std;

int main(){
    int n;
    cout <<"enter a size of an array= ";
    cin >> n;
    
    int arr[n];
    cout <<"enter the sorted array ";
    for(int i=0; i<n ; i++){
        cin >> arr[i];
    }
    
    int target;
    cout <<"enter the target / search element= ";
    cin>> target;
    // Binary Search Algorithm . 
    
    int low=0;
    int high=n-1;
    bool found =false;
    
    while(low<=high){
        int mid=(low+high)/2;
        
        if(arr[mid] == target){
            cout <<"element found at index "<< mid;
            found=true;
            break;
        }else if(arr[mid] < target){
            low = mid+1;
            
        }
        else{
            high = mid-1;
        }
    }
    if(found== false){
        cout <<"Element not found.. ";
    }
    return 0;
}
