#include<iostream>
#include <stack>
using namespace std;
int main(){
    int arr[]={10,20,30,40,50};
    int n=5;
    
    stack<int> st;
    // in java - stack<Integer> st= new stack();
    //Push the data inside a stack 
    
    for(int i=0; i<n; i++){
        st.push(arr[i]);
        
    }
    // Pop out the top most data from the stack 
     
    for(int i=0; i<n; i++){
        arr[i] = st.top();
        st.pop();
    }
    cout<<"reverse array "<<"\n";
    
    for(int i=0; i<n; i++){
        cout<< arr[i]<<" ";
    }
    return 0;
}

Reverse string with the help of Stack 
class Solution {
public:
    void reverseString(vector<char>& s) {
    stack<char>st;
    for(int i=0 ; i<s.size() ;i++){
        st.push(s[i]);
    }    
    for(int i=0 ; i<s.size() ;i++){
        s[i] = st.top();
        st.pop();
    }
    }
};

Valid Parentheses .

class Solution {
public:
    bool isValid(string s) {
        stack<char> st;
        for(char c : s){
            if(c == '(')
                st.push(')');
            else if( c == '[')
                st.push(']');
            else if(c == '{')
                st.push( '}' );
            else{
                if(st.empty() || st.top()!=c){
                    return false;
                }st.pop();
            }


        }
        return st.empty();
    }
    };


Next Greater Element
class Solution {
  public:
    vector<int> nextLargerElement(vector<int>& arr) {
        // code here
        int n=arr.size();
        stack<int> st;
        vector<int> nge(n);
        
        for(int i=n-1;i>=0 ;i--){
            while(!st.empty() && st.top() <=arr[i]){
                st.pop();
            }
            if(st.empty()){
                nge[i]=-1;
            }else{
                nge[i]=st.top();
            }
            st.push(arr[i]);
        }
        return nge;
    }
};
